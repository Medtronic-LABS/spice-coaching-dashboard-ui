server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = / {
        return 302 __ROUTE_PREFIX__/;
    }

    location = __ROUTE_PREFIX__ {
        return 301 __ROUTE_PREFIX__/$is_args$args;
    }

    location __ROUTE_PREFIX__/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ __ROUTE_PREFIX__/index.html;
    }
}
