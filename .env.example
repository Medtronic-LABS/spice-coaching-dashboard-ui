## Vite environment variables (client-exposed)
## Only variables prefixed with VITE_ are exposed to the browser.

# API origin for dashboard and admin routes (example: https://api.example.com/medtronics-api)
VITE_API_BASE_URL=

# Toggle mock API (set to false to use VITE_API_BASE_URL with fetchBaseQuery).
VITE_USE_MOCK_API=true

# Toggle mock program-manager module-creation pipeline (false = real server).
VITE_USE_MOCK_MODULE_PIPELINE=true
