## Vite environment variables (client-exposed)
## Only variables prefixed with VITE_ are exposed to the browser.

# Base API URL when using the real backend (example: https://api.example.com/api/v1)
VITE_API_BASE_URL=

# Base URL for admin module-creation APIs (example: http://localhost:8001)
VITE_ADMIN_API_BASE_URL=http://localhost:8001

# Sent as the X-Reviewer-Id header on admin API calls. Replace with the UUID
# issued by your admin backend before deploying. Empty by default so misconfig
# fails loudly instead of silently authenticating as a placeholder.
VITE_ADMIN_REVIEWER_ID=00000000-0000-0000-0000-000000000000

# Sent as the X-Reviewer-Token header on admin API calls. Replace with the real
# token before deploying.
VITE_ADMIN_REVIEWER_TOKEN=replace-with-real-reviewer-token

# Toggle mock API mode (true/false). When true, the supervisor/CHW analytics
# RTK Query endpoints are served from local mock data. Mock mode is on by
# default for local dev.
VITE_USE_MOCK_API=true

# Toggle mock mode for the admin module-creation pipeline (true/false). When
# true (default), admin module APIs are answered by local mocks. Set to false
# to call the real admin server at VITE_ADMIN_API_BASE_URL.
VITE_USE_MOCK_MODULE_PIPELINE=true

# App role switch for UI routing: supervisor | programManager
VITE_APP_ROLE=supervisor
