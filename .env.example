## Copy to `.env` for local dev and CI tests (`npm run ensure-env` creates it automatically).
## Do not commit `.env`. Production builds override via CI/CD variables or Docker build args.

# API origin for dashboard and admin routes (example: https://api.example.com/medtronics-api)
VITE_API_BASE_URL=

# Mock API for supervisor/dashboard routes (set false for production builds)
VITE_USE_MOCK_API=true

# Enable dashboard login page (set false to disable login flow and use Spice cookie bootstrap)
VITE_ENABLE_LOGIN=true

# Same role as SPICE `REACT_APP_PASSWORD_HASH_KEY` — client HMAC-SHA512 key before login POST
# (not a server secret; must match Spice admin-web. Do not commit real deployment values.)
VITE_PASSWORD_HASH_KEY=

# Legacy alias for password hash key (used only if VITE_PASSWORD_HASH_KEY is unset)
VITE_HMAC_SECRET_KEY=

# When VITE_USE_MOCK_API=true, admin/* still uses VITE_API_BASE_URL
VITE_USE_MOCK_MODULE_PIPELINE=false

# Public URL path where the SPA is served (leading slash, no trailing slash)
VITE_ROUTE_PREFIX=/ai-coaching

# CHW-facing primary locale for module content display (ISO 639-1, default bn)
VITE_DEPLOYMENT_PRIMARY_LOCALE=bn

# Vite dev proxy target for /admin-service, /user-service
VITE_SPICE_API_BASE_URL=https://spice-dev-backend.uhis.labsplatform.com

# Spice web app used when the session cookie is missing or coaching suite access is denied
VITE_SPICE_WEB_LOGIN_URL=https://spice-dev.uhis.labsplatform.com/

# Spice suiteAccess entry required to enter this dashboard (case-insensitive)
VITE_COACHING_SUITE_ACCESS=coaching

# SPICE Microservices APIs (use relative paths in dev so Vite proxy forwards cookies)
VITE_SPICE_ADMIN_API_URL=/admin-service
VITE_SPICE_USER_API_URL=/user-service
