## Vite environment variables (client-exposed)
## Only variables prefixed with VITE_ are exposed to the browser.

# API origin for dashboard and admin routes (example: https://api.example.com/medtronics-api)
VITE_API_BASE_URL=

# Toggle mock API for supervisor/dashboard routes (set to false for all real traffic).
VITE_USE_MOCK_API=true

# When VITE_USE_MOCK_API=true, admin/* (modules, ingest, files, pipeline) still use
# VITE_API_BASE_URL. Set to true only if you add local admin mocks later.
VITE_USE_MOCK_MODULE_PIPELINE=false
